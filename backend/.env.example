# ==============================================================================
# GitWise Backend Environment Variables (Phase 1)
# ==============================================================================

# Application environment ("development" | "production" | "test")
APP_ENV=development

# Server bind host and port
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# PostgreSQL 16 + pgvector connection string
# Matches credentials defined in backend/docker-compose.yml
DATABASE_URL=postgres://gitwise:gitwise@localhost:5432/gitwise?sslmode=disable

# Frontend origin for intentional CORS allowlist (no wildcard in production)
FRONTEND_ORIGIN=http://localhost:3000

# Logging verbosity level ("debug" | "info" | "warn" | "error")
LOG_LEVEL=info
