# ==============================================================================
# GitWise Backend Environment Variables (Phase 1)
# ==============================================================================

# Application environment ("development" | "production" | "test")
APP_ENV=development

# Server bind host and port
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# PostgreSQL 16 + pgvector connection string
# Matches credentials defined in backend/docker-compose.yml
DATABASE_URL=postgres://gitwise:gitwise@localhost:5432/gitwise?sslmode=disable

# Frontend origin for intentional CORS allowlist (no wildcard in production)
FRONTEND_ORIGIN=http://localhost:3000

# Logging verbosity level ("debug" | "info" | "warn" | "error")
LOG_LEVEL=info

# ==============================================================================
# AI Provider & Model Configuration (Phase 7: Mentor & Grounded Chat)
# ==============================================================================
# Supported providers: "groq", "ollama", "openrouter", "openai", "openai_compatible", "gemini", "mock"
# Default provider is "groq" (fast, high-rate-limit free tier).
AI_PROVIDER=groq

# Groq Configuration (Free tier: https://console.groq.com/keys)
# Models: "llama-3.3-70b-versatile", "llama-3.1-8b-instant", "mixtral-8x7b-32768"
GROQ_API_KEY=
AI_MODEL=llama-3.3-70b-versatile

# Ollama Configuration (100% Free & Local, no API key required)
# AI_PROVIDER=ollama
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.2

# OpenRouter Configuration (Free models e.g. "meta-llama/llama-3.3-70b-instruct:free")
# AI_PROVIDER=openrouter
# AI_API_KEY=sk-or-v1-...
# AI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Standard OpenAI / OpenAI-Compatible custom proxy
# AI_PROVIDER=openai_compatible
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Google Gemini (Optional)
# GEMINI_API_KEY=
